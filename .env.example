# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Database (docker-compose sets this automatically for local dev;
# override with your RDS connection string when deploying)
DATABASE_URL=postgresql://logimind_app:CHANGE_ME_APP_PASSWORD@db:5432/logimind

# ChromaDB (embedded mode) persistence directory -- RAG policy storage.
# Mounted as a Docker volume so data survives container restarts (see
# docker-compose.yml). On EC2, this is just a folder on the instance's
# own disk -- no separate service or port involved.
CHROMA_PERSIST_DIR=/app/chroma_data

# LangSmith (tracing + evaluation)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=logimind

# App
JWT_SECRET=changeme
ENVIRONMENT=dev
